# Installierte JavaScript-Pakete (werden per npm install neu generiert)
node_modules/

# Fertig gebaute App (wird per npm run build neu generiert)
dist/

# Python: Virtuelle Umgebung der Konvertierungsscripts
tools/.venv/

# TypeScript Build-Cache
*.tsbuildinfo

# Editor-spezifische Dateien
.vscode/
.idea/
*.swp

# Betriebssystem-Dateien
.DS_Store
Thumbs.db

# Lokale Umgebungsvariablen (falls nötig)
.env.local

# Claude Code: lokale Einstellungen und Session-Resume-Dateien (nicht ins Repo)
.claude/
resume.md

# MediaPipe-WASM: wird bei npm install aus node_modules kopiert (postinstall),
# damit die App keine Dateien von Fremd-Servern (CDN) nachlädt
public/mediapipe/

# Python-Caches (pytest, ruff)
__pycache__/
.pytest_cache/
.ruff_cache/
